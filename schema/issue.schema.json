{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huggingface.co/datasets/jira-issue-writer/schema/issue.schema.json",
  "title": "Jira issue draft",
  "description": "Modelin draft_issue / bug_from_log gorevlerinde urettigi cikti. Jira REST API v3 POST /rest/api/3/issue govdesine dogrudan map edilir.",
  "type": "object",
  "required": ["issue_type", "summary", "description", "priority", "labels",
               "components", "assumptions", "clarifying_questions", "dor_check"],
  "additionalProperties": false,
  "properties": {
    "issue_type": {"enum": ["Epic", "Story", "Task", "Bug", "Spike", "Sub-task"]},
    "summary":    {"type": "string", "minLength": 8, "maxLength": 120,
                   "description": "Emir kipi, tur oneki yok, nokta ile bitmez"},
    "description":{"type": "string", "minLength": 40,
                   "description": "Jira wiki markdown; bolum basliklari 'h2. '"},
    "priority":   {"enum": ["Highest", "High", "Medium", "Low", "Lowest"]},
    "severity":   {"oneOf": [{"enum": ["Critical", "Major", "Minor", "Trivial"]}, {"type": "null"}],
                   "description": "Yalnizca Bug icin; Priority'den bagimsizdir"},
    "labels":     {"type": "array", "maxItems": 6, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "components": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "story_points": {"oneOf": [{"enum": [1, 2, 3, 5, 8, 13]}, {"type": "null"}]},
    "acceptance_criteria": {
      "type": "array", "maxItems": 10,
      "items": {"type": "object",
        "required": ["id", "given", "when", "then"],
        "properties": {"id": {"type": "string", "pattern": "^AC[0-9]+$"},
                       "given": {"type": "string"}, "when": {"type": "string"},
                       "then": {"type": "string"}}}},
    "subtasks":   {"type": "array", "items": {"type": "string"}},
    "parent_hint":{"oneOf": [{"type": "string"}, {"type": "null"}]},
    "assumptions":{"type": "array", "items": {"type": "string"},
                   "description": "Girdide olmayan ama cikti icin gereken her sey buraya yazilir"},
    "clarifying_questions": {"type": "array", "items": {"type": "string"},
                   "description": "Cevabi olmadan riskli kalan sorular"},
    "dor_check":  {"type": "object", "required": ["ready", "missing"],
                   "properties": {"ready": {"type": "boolean"},
                                  "missing": {"type": "array", "items": {"type": "string"}}}}
  }
}
